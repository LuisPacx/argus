{
  "name": "argus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "worker": "pnpm --filter @argus/worker start",
    "warroom": "pnpm --filter @argus/warroom dev"
  },
  "devDependencies": {
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
