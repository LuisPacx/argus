{
  "name": "argus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "worker": "pnpm --filter @argus/worker start",
    "warroom": "pnpm --filter @argus/warroom dev",
    "dev:start": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:status": "node scripts/dev-server.mjs status",
    "verify:boot": "node scripts/verify-boot.mjs",
    "verify:parent": "node scripts/verify-parent.mjs",
    "image:build": "node scripts/image-build.mjs",
    "verify:contain": "node scripts/verify-contain.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
