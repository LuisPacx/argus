      "boundElements": [],
      "updated": 1762500000000,
      "link": null,
      "locked": false,
      "text": "Human in the loop\nA person decides at every gate: shortlist, approve\nthe Spec, dismiss, launch. Argus never launches a\ntoken and holds no wallet.",
      "originalText": "Human in the loop\nA person decides at every gate: shortlist, approve\nthe Spec, dismiss, launch. Argus never launches a\ntoken and holds no wallet.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
