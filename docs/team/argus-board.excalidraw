      "boundElements": [],
      "updated": 1762500000000,
      "link": null,
      "locked": false,
      "text": "Subscription only\nAI work runs on the Claude subscription, not\npay-per-use. The optional paid fallback is off,\nand capped at $0.50 a day if ever turned on.",
      "originalText": "Subscription only\nAI work runs on the Claude subscription, not\npay-per-use. The optional paid fallback is off,\nand capped at $0.50 a day if ever turned on.",
