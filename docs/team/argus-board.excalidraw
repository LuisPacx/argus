      "versionNonce": 6261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762500000000,
      "link": null,
      "locked": false,
      "text": "Containment\nBuilds run in a locked container: no passwords or\nkeys inside, internet only to two allowed sites,\nno access to the Operator's files. There is no\nuncontained mode.",
      "originalText": "Containment\nBuilds run in a locked container: no passwords or\nkeys inside, internet only to two allowed sites,\nno access to the Operator's files. There is no\nuncontained mode.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-96",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
