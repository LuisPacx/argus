      "boundElements": [],
      "updated": 1762500000000,
      "link": null,
      "locked": false,
      "text": "Budget caps\nEvery AI run has a spend cap. Research is held to\nabout 30% of the daily plan. A Build gets a $25\ncap and 4 hours. Hitting a cap stops the run; caps\nare never raised silently.",
      "originalText": "Budget caps\nEvery AI run has a spend cap. Research is held to\nabout 30% of the daily plan. A Build gets a $25\ncap and 4 hours. Hitting a cap stops the run; caps\nare never raised silently.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-98",
      "autoResize": true,
      "lineHeight": 1.25
    },
