#!/bin/sh
# Skip the (slow) check when each pushed ref differs from origin, or from a commit whose tree already passed `pnpm check`
# (a stamp, see scripts/check-stamp.mjs), only by notes (.scratch/** or *.md, not .claude/**), or is itself stamped.
# scripts/prepush-decision.mjs exits 0 only then; any other outcome, including a crash, runs the check.
refs=$(cat)
if printf '%s\n' "$refs" | node "$(dirname "$0")/../scripts/prepush-decision.mjs"; then
  exit 0
fi
if ! pnpm check; then
  echo "pre-push: pnpm check failed; push blocked" >&2
  exit 1
fi
