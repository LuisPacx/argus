# Expected variables. Fill values in a local, gitignored .env. Never commit values.
CLAUDE_CODE_OAUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ARGUS_DATA_DIR=
ARGUS_DRY_RUN=
# Ingestion (optional): the RSS catalog, default config/rss-feeds.json
ARGUS_RSS_FEEDS=
# Google Trends and DexScreener need no key and are on by default. ARGUS_INGEST_STANDING=0 turns both off.
# The URL overrides exist for tests and local mirrors; leave them unset (empty falls back to the real endpoint).
# ARGUS_INGEST_STANDING=0
# ARGUS_TRENDS_URL=
# ARGUS_DEXSCREENER_URL=
# ARGUS_GITHUB_URL=
# Narrative embedder model (optional; ADR 0007). Cache default ~/.cache/argus/models; `pnpm models:fetch` pre-fetches it.
# ARGUS_MODEL_DIR=
# ARGUS_MODEL_HOST=
# ARGUS_EMBEDDER=hashing is the lexical embedder, for development and tests only
# Judge caps (optional; defaults 10 Narratives per pass, 150 runs and $2 per rolling 24 hours)
# ARGUS_JUDGE_MAX_PER_PASS=
# ARGUS_JUDGE_MAX_RUNS_PER_DAY=
# ARGUS_JUDGE_MAX_DAILY_USD=
# Propose caps (optional; defaults 3 Narratives per pass, 30 runs per rolling 24 hours; at most 10 new Proposals a day, which can only be lowered)
# ARGUS_PROPOSE_MAX_PER_PASS=
# ARGUS_PROPOSE_MAX_RUNS_PER_DAY=
# ARGUS_PROPOSE_MAX_NEW_PER_DAY=
# Research share: judge plus propose may use ARGUS_DAILY_QUOTA_USD x ARGUS_RESEARCH_SHARE of Est. usage in any rolling 24 hours.
# The quota is your estimate of the Est. usage (API-equivalent $) your plan allows per day; defaults $20 and 0.3 ($6)
# ARGUS_DAILY_QUOTA_USD=
# ARGUS_RESEARCH_SHARE=
# Launch handoff (optional; ADR 0002). newpairspam's base URL (its `nuxt dev` serves on http://localhost:3000) and a public http(s) logo URL.
# newpairspam's image proxy rejects SVG, so the logo must be a raster image; none is sent when unset.
# ARGUS_NEWPAIRSPAM_URL=
# ARGUS_LAUNCH_LOGO_URL=
# Build containment (optional overrides; the Build token itself lives in ~/.config/argus/build-token, chmod 600, never here)
ARGUS_PODMAN_BIN=
ARGUS_BUILD_IMAGE=
ARGUS_BUILD_TOKEN_FILE=
ARGUS_BUILD_MEMORY_GIB=
ARGUS_BUILD_CPUS=
ARGUS_BUILD_PIDS=
ARGUS_BUILD_TMP_GIB=
